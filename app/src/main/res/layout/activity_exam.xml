<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/examRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <!-- 固定顶部导航，页面滚动时返回箭头保持可见 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_home_header">

        <TextView
            android:id="@+id/tvExamToolbarTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            android:gravity="center"
            android:text="@string/action_exam"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBackFromExam"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:padding="12dp"
            android:background="@drawable/bg_practice_back_ripple"
            android:contentDescription="@string/exam_back_preparation"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_practice_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/btnSubmitExam"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_practice_back_ripple"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:enabled="false"
            android:contentDescription="@string/exam_submit_title"
            android:text="@string/exam_submit_action"
            android:textColor="@color/white"
            android:textSize="15sp" />

    </FrameLayout>

    <ScrollView
        android:id="@+id/scrollExamQuestion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/examStatusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvExamAnsweredCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/exam_questions_loading"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvExamTimeRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <include layout="@layout/panel_exam_result" />

            <!-- 题目卡片 -->
            <LinearLayout
                android:id="@+id/examQuestionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_overview"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvExamQuestionProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exam_questions_loading"
                    android:textColor="@color/brand_blue"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvExamQuestionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/groupExamOptions"
                    android:saveEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExamRetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/exam_retry"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:backgroundTint="@color/brand_blue"
                    app:cornerRadius="16dp" />

            </LinearLayout>

            <!-- 切题按钮 -->
            <LinearLayout
                android:id="@+id/examNavigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExamPrevious"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:enabled="false"
                    android:text="@string/practice_previous"
                    app:backgroundTint="@color/brand_blue"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExamNext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:enabled="false"
                    android:text="@string/practice_next"
                    app:backgroundTint="@color/brand_blue"
                    app:cornerRadius="16dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
