<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wrongQuestionsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_home_header">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            android:gravity="center"
            android:text="@string/action_mistakes"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBackFromWrong"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:padding="12dp"
            android:background="@drawable/bg_practice_back_ripple"
            android:contentDescription="@string/practice_back_home"
            app:srcCompat="@drawable/ic_practice_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/btnClearWrongQuestions"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_practice_back_ripple"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:enabled="false"
            android:alpha="0.45"
            android:contentDescription="@string/wrong_clear_title"
            android:text="@string/wrong_clear_action"
            android:textSize="15sp"
            android:textColor="@color/white" />

    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/wrong_questions_hint"
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvWrongCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/wrong_questions_loading"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listWrongQuestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:cacheColorHint="@android:color/transparent" />

        <TextView
            android:id="@+id/tvWrongEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:lineSpacingExtra="8dp"
            android:text="@string/wrong_questions_loading"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />

    </FrameLayout>

</LinearLayout>
